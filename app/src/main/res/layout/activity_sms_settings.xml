<?xml version="1.0" encoding="utf-8" ?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/smsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    tools:context=".SmsSettingsActivity">

    <!-- Screen title -->
    <TextView
        android:id="@+id/textSmsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Notification Settings"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="24dp" />

    <!-- Short explanation -->
    <TextView
        android:id="@+id/textSmsDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Enable SMS alerts so Event Tracker can send you reminders about your upcoming events."
        android:textSize="14sp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/textSmsTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Row: label + switch (main control) -->
    <TextView
        android:id="@+id/textSmsToggleLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SMS event reminders"
        android:textSize="16sp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/textSmsDescription"
        app:layout_constraintStart_toStartOf="parent" />

    <Switch
        android:id="@+id/switchSmsEnable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checked="false"
        app:layout_constraintTop_toTopOf="@id/textSmsToggleLabel"
        app:layout_constraintBottom_toBottomOf="@id/textSmsToggleLabel"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Button to trigger permission check / request -->
    <Button
        android:id="@+id/buttonCheckPermission"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Enable SMS Permissions"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/textSmsToggleLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Status area: what will happen / current state -->
    <TextView
        android:id="@+id/textSmsStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="SMS alerts are already turned off."
        android:textSize="14sp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/buttonCheckPermission"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Optional preview of the type of SMS they will get -->
    <TextView
        android:id="@+id/textSmsPreviewLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sample reminder:"
        android:textStyle="bold"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/textSmsStatus"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/textSmsPreview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Reminder: Your event 'Team Meeting' starts tomorrow at 3:00 PM."
        android:textSize="14sp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/textSmsPreviewLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>